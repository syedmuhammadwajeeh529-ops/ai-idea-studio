import express from "express";
import multer from "multer";
import path from "path";
import fs from "fs";
import dotenv from "dotenv";
import { fileURLToPath } from "url";
import { db } from "./db.js";
import { aiProvider } from "./services/aiProvider.js";
import { ensureDirectory, getStoragePath, saveAsset } from "./storage.js";

dotenv.config();

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const port = process.env.PORT || 3000;

const upload = multer({ storage: multer.memoryStorage() });

const toJson = (value) => {
  try {
    return value ? JSON.parse(value) : {};
  } catch {
    return {};
  }
};

const getProjectWithDetails = (projectId) => {
  const project = db.prepare(`SELECT * FROM projects WHERE id = ?`).get(projectId);
  if (!project) return null;

  const scenes = db
    .prepare(`SELECT * FROM scenes WHERE project_id = ? ORDER BY scene_order ASC, created_at ASC`)
    .all(projectId);

  const versions = db
    .prepare(`SELECT * FROM versions WHERE project_id = ? ORDER BY created_at DESC`)
    .all(projectId);

  const media = db
    .prepare(`SELECT * FROM media_assets WHERE project_id = ? ORDER BY created_at DESC`)
    .all(projectId);

  const finalVideos = db
    .prepare(`SELECT * FROM final_videos WHERE project_id = ? ORDER BY created_at DESC`)
    .all(projectId);

  return {
    ...project,
    scenes,
    versions,
    media,
    finalVideos
  };
};

const normalizeProject = (payload) => ({
  title: payload.title || "Untitled Project",
  description: payload.description || "",
  idea: payload.idea || "",
  genre: payload.genre || "",
  audience: payload.audience || "",
  style: payload.style || "",
  language: payload.language || "English",
  aspect_ratio: payload.aspect_ratio || "16:9",
  target_duration: Number(payload.target_duration || 60),
  status: payload.status || "Draft"
});

const createProjectVersion = (projectId, label, content) => {
  db.prepare(
    `INSERT INTO versions (id, project_id, label, content) VALUES (?, ?, ?, ?)`
  ).run(crypto.randomUUID(), projectId, label, JSON.stringify(content));
};

app.use(express.json({ limit: "20mb" }));
app.use(express.urlencoded({ extended: true }));

app.use(express.static(path.join(__dirname, "public")));

app.get("/api/health", (_req, res) => {
  res.json({ ok: true, status: "healthy" });
});

app.get("/api/projects", (_req, res) => {
  const projects = db.prepare(`SELECT * FROM projects ORDER BY updated_at DESC`).all();
  res.json({ projects });
});

app.post("/api/projects", (req, res) => {
  const project = normalizeProject(req.body || {});
  const id = crypto.randomUUID();

  db.prepare(
    `INSERT INTO projects (id, title, description, idea, genre, audience, style, language, aspect_ratio, target_duration, status)
     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
  ).run(
    id,
    project.title,
    project.description,
    project.idea,
    project.genre,
    project.audience,
    project.style,
    project.language,
    project.aspect_ratio,
    project.target_duration,
    project.status
  );

  createProjectVersion(id, "Created", project);

  const projectWithDetails = getProjectWithDetails(id);
  res.status(201).json({ project: projectWithDetails });
});

app.get("/api/projects/:id", (req, res) => {
  const project = getProjectWithDetails(req.params.id);
  if (!project) {
    return res.status(404).json({ error: "Project not found" });
  }
  res.json({ project });
});

app.put("/api/projects/:id", (req, res) => {
  const project = getProjectWithDetails(req.params.id);
  if (!project) {
    return res.status(404).json({ error: "Project not found" });
  }

  const updates = normalizeProject({ ...project, ...(req.body || {}) });

  db.prepare(
    `UPDATE projects
     SET title = ?, description = ?, idea = ?, genre = ?, audience = ?, style = ?, language = ?, aspect_ratio = ?, target_duration = ?, status = ?, updated_at = CURRENT_TIMESTAMP
     WHERE id = ?`
  ).run(
    updates.title,
    updates.description,
    updates.idea,
    updates.genre,
    updates.audience,
    updates.style,
    updates.language,
    updates.aspect_ratio,
    updates.target_duration,
    updates.status,
    req.params.id
  );

  createProjectVersion(req.params.id, "Updated", updates);

  const updated = getProjectWithDetails(req.params.id);
  res.json({ project: updated });
});

app.delete("/api/projects/:id", (req, res) => {
  const project = getProjectWithDetails(req.params.id);
  if (!project) {
    return res.status(404).json({ error: "Project not found" });
  }

  db.prepare(`DELETE FROM projects WHERE id = ?`).run(req.params.id);
  res.json({ success: true, deletedId: req.params.id });
});

app.post("/api/projects/:id/generate-plan", (req, res) => {
  const project = getProjectWithDetails(req.params.id);
  if (!project) {
    return res.status(404).json({ error: "Project not found" });
  }

  const plan = aiProvider.buildPlan(project);
  const sceneRows = plan.scenes || [];

  db.prepare(`DELETE FROM scenes WHERE project_id = ?`).run(req.params.id);

  sceneRows.forEach((scene, index) => {
    const sceneId = crypto.randomUUID();
    db.prepare(
      `INSERT INTO scenes (id, project_id, title, summary, narration, dialogue, visual_prompt, scene_order)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
    ).run(
      sceneId,
      req.params.id,
      scene.title,
      scene.summary,
      scene.narration,
      scene.dialogue,
      scene.visual_prompt,
      index + 1
    );
  });

  db.prepare(`UPDATE projects SET status = 'Planning', updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(req.params.id);
  createProjectVersion(req.params.id, "Plan generated", plan);

  const updated = getProjectWithDetails(req.params.id);
  res.json({ ok: true, plan, project: updated, providerStatus: aiProvider.status() });
});

app.post("/api/projects/:id/generate-images", async (req, res) => {
  const project = getProjectWithDetails(req.params.id);
  if (!project) {
    return res.status(404).json({ error: "Project not found" });
  }

  const sceneId = req.body?.sceneId || project.scenes?.[0]?.id;
  const scene = project.scenes.find((entry) => entry.id === sceneId) || project.scenes[0];
  const prompt = req.body?.prompt || scene?.visual_prompt || `${project.title} cinematic still`;

  const result = await aiProvider.generateImage({ project, scene, prompt, type: req.body?.type || "scene" });

  if (!result.ok) {
    db.prepare(`UPDATE projects SET status='Failed', updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(req.params.id);
    return res.status(503).json({ ok: false, providerRequired: true, message: result.error });
  }

  const assetId = crypto.randomUUID();
  db.prepare(
    `INSERT INTO media_assets (id, project_id, scene_id, type, name, provider, status, metadata)
     VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
  ).run(
    assetId,
    req.params.id,
    scene?.id || null,
    req.body?.type || "scene",
    `${project.title}-${scene?.title || "scene"}.png`,
    result.provider,
    "Generated",
    JSON.stringify({ prompt, provider: result.provider })
  );

  db.prepare(`UPDATE projects SET status='Generating Images', updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(req.params.id);
  const updated = getProjectWithDetails(req.params.id);
  res.json({ ok: true, result, project: updated });
});

app.post("/api/projects/:id/generate-video", async (req, res) => {
  const project = getProjectWithDetails(req.params.id);
  if (!project) {
    return res.status(404).json({ error: "Project not found" });
  }

  const sceneId = req.body?.sceneId || project.scenes?.[0]?.id;
  const scene = project.scenes.find((entry) => entry.id === sceneId) || project.scenes[0];
  const prompt = req.body?.prompt || scene?.visual_prompt || `${project.title} moving scene`;

  const result = await aiProvider.generateVideoClip({ project, scene, prompt });

  if (!result.ok) {
    db.prepare(`UPDATE projects SET status='Failed', updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(req.params.id);
    return res.status(503).json({ ok: false, providerRequired: true, message: result.error });
  }

  const clipId = crypto.randomUUID();
  db.prepare(
    `INSERT INTO media_assets (id, project_id, scene_id, type, name, provider, status, metadata)
     VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
  ).run(
    clipId,
    req.params.id,
    scene?.id || null,
    "video",
    `${project.title}-${scene?.title || "scene"}.mp4`,
    result.provider,
    "Queued",
    JSON.stringify({ prompt, provider: result.provider })
  );

  db.prepare(`UPDATE projects SET status='Generating Video', updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(req.params.id);
  const updated = getProjectWithDetails(req.params.id);
  res.json({ ok: true, result, project: updated });
});

app.post("/api/projects/:id/assemble-video", async (req, res) => {
  const project = getProjectWithDetails(req.params.id);
  if (!project) {
    return res.status(404).json({ error: "Project not found" });
  }

  const result = await aiProvider.assembleFinalVideo({ project, scenes: project.scenes });
  if (!result.ok) {
    db.prepare(`UPDATE projects SET status='Failed', updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(req.params.id);
    return res.status(503).json({ ok: false, providerRequired: true, message: result.error });
  }

  const videoId = crypto.randomUUID();
  db.prepare(
    `INSERT INTO final_videos (id, project_id, title, status, metadata)
     VALUES (?, ?, ?, ?, ?)`
  ).run(videoId, req.params.id, `${project.title}-final.mp4`, "Ready", JSON.stringify({ provider: result.provider, scenes: project.scenes.length }));

  db.prepare(`UPDATE projects SET status='Completed', updated_at = CURRENT_TIMESTAMP WHERE id = ?`).run(req.params.id);
  const updated = getProjectWithDetails(req.params.id);
  res.json({ ok: true, result, project: updated });
});

app.post("/api/projects/:id/version", (req, res) => {
  const project = getProjectWithDetails(req.params.id);
  if (!project) {
    return res.status(404).json({ error: "Project not found" });
  }

  const label = req.body?.label || `Manual save ${new Date().toLocaleString()}`;
  createProjectVersion(req.params.id, label, { idea: project.idea, title: project.title, updatedAt: new Date().toISOString() });
  res.json({ ok: true, label });
});

app.get("/api/provider-status", (_req, res) => {
  res.json(aiProvider.status());
});

app.listen(port, () => {
  console.log(`AI Idea Studio running on http://localhost:${port}`);
});

export default app;
